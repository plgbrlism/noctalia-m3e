[Desktop Entry]
Type=Application
Name=Vespertine
Comment=A sleek, customizable desktop shell crafted for Wayland.
Exec=vespertine --daemon
Icon=vespertine
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Actions=Settings;
Keywords=desktop;shell;wayland;

[Desktop Action Settings]
Name=Open Settings
Exec=sh -c "vespertine msg settings-open || { vespertine --daemon && vespertine msg settings-open; }"
